# OREOCHAIN gateway configuration.
#
#   cp .env.example .env    and fill in the blanks.
#
# .env is gitignored. This file is the documented shape, and must never hold a
# real credential — CI fails the build if one appears in the repository.
#
# Every setting is described in server/README.md; this is the subset you
# actually have to think about for a deployment.

# ---------------------------------------------------------------- the basics

PORT=8787

# Inside a container this must be 0.0.0.0 or the gateway is unreachable from
# outside its network namespace. On a host, keep it on loopback behind a
# reverse proxy that terminates TLS.
HOST=0.0.0.0

# ------------------------------------------------------------------ security

# Comma-separated client keys, each at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A key is shared with a client and cannot be revoked individually without a
# restart, so issue one per client rather than one for everyone.
OREOCHAIN_API_KEYS=

# The subset of the keys above allowed to drive anchoring: build a batch, read
# what is unanchored, and record where a root landed on-chain. Issue one to the
# anchoring worker alone. Everything else gets a 403 on those three endpoints.
#
# Why it is separate: the transaction hash recorded here is served to everyone
# who asks for a proof in that batch, so a client that could post a plausible
# fake would send every verifier to a transaction that does not exist, and the
# real anchor would then be refused as a conflict.
#
# Unset means nothing may anchor, and the gateway says so at startup.
OREOCHAIN_ANCHOR_API_KEYS=

# Serve anyone, with no key. This is a supported production configuration —
# the premise is that a visitor needs no account — and what makes it safe is
# the ceilings below, not authentication. With a pinning account the gateway
# refuses to start in this mode until all four are set.
# OREOCHAIN_ALLOW_ANONYMOUS=false

# How many reverse proxies of your own a request passes through. REQUIRED if
# there is one: every per-client limit is keyed on the client's address, and
# behind a proxy at 0 every visitor shares one budget. Never trusted by
# default, because anyone can send X-Forwarded-For.
# OREOCHAIN_TRUSTED_PROXY_HOPS=1

# What one client may pin per window, and what the whole service may pin per
# day. Rate limiting bounds how often someone calls; these bound what it costs.
# Numbers below are a place to start — pick what you could afford to lose in a
# day. The daily counter resets at 00:00 UTC and on restart.
# OREOCHAIN_CLIENT_BYTES_PER_WINDOW=268435456
# OREOCHAIN_CLIENT_OBJECTS_PER_WINDOW=1024
# OREOCHAIN_QUOTA_WINDOW_MS=3600000
# OREOCHAIN_DAILY_BYTES=5368709120
# OREOCHAIN_DAILY_OBJECTS=20000

# Browser origins allowed via CORS, comma-separated. Empty means same-origin
# only. "*" is refused: these endpoints are authenticated.
# OREOCHAIN_ALLOWED_ORIGINS=https://app.example.com

# ------------------------------------------------------------------- secrets
#
# Each of these also accepts a <NAME>_FILE twin pointing at a file, which is
# how Docker secrets and Kubernetes secret mounts supply a credential. Prefer
# the file: a value in the environment is readable through `docker inspect`,
# through /proc, and by every child process. Setting both is an error.

# The pinning credential. Never leaves the gateway process.
PINATA_JWT=
# PINATA_JWT_FILE=/run/secrets/pinata_jwt

# Signs every receipt the gateway issues. Generate with:
#   node scripts/generate-receipt-key.mjs
# Without it receipts are signed with a throwaway key and every restart
# invalidates the ones already handed out.
OREOCHAIN_RECEIPT_KEY=
# OREOCHAIN_RECEIPT_KEY_FILE=/run/secrets/receipt_key

# --------------------------------------------------------------------- state

# Recorded documents and anchored batches. This must be on storage that
# outlives the container: an anchored batch's ordered document list is the only
# thing that can turn "this root is on-chain" into "your document is in it".
# Back it up.
OREOCHAIN_DB_PATH=/data/oreochain-proofs.log

# ------------------------------------------------------------------ operating

# debug, info, warn, error, silent
OREOCHAIN_LOG_LEVEL=info

# Keep serving this long after SIGTERM so a load balancer's readiness probe
# sees /ready go 503 before the listener closes. Set it to a little more than
# the probe interval.
OREOCHAIN_SHUTDOWN_DELAY_MS=5000

# Request bodies buffered at once, process-wide. Past this the gateway sheds
# with a 503 rather than running the host out of memory. Roughly:
# OREOCHAIN_MAX_CONCURRENT_UPLOADS * OREOCHAIN_MAX_CHUNK_BYTES is the ceiling.
# OREOCHAIN_MAX_CONCURRENT_UPLOADS=32
# OREOCHAIN_MAX_CHUNK_BYTES=1048576

# Per-key token bucket.
# OREOCHAIN_RATE_LIMIT_PER_MINUTE=600
# OREOCHAIN_RATE_LIMIT_BURST=120

# Serve the frontend from the gateway too, so there is no CORS at all.
# OREOCHAIN_SERVE_STATIC=false

# -------------------------------------------------- reading the chain (gateway)

# Optional, and read-only: no key, nothing here can spend. With it the public
# GET /api/proofs/verify/<fileHash> confirms anchors itself, so a verifier with
# no wallet and no RPC endpoint gets an answer. Without it that endpoint says it
# cannot check, which is the one answer that is never wrong.
#
# Both settings or neither — half of this pair is a mistake.
# OREOCHAIN_CHAIN_RPC=https://rpc.example
# OREOCHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# An anchored root does not change, so it is cached hard. This is what stands
# between a public endpoint and your RPC bill.
# OREOCHAIN_CHAIN_CACHE_MS=3600000

# Public verification is metered separately from uploads, by source address,
# because it is unauthenticated and every miss costs a chain read.
# OREOCHAIN_VERIFY_RATE_LIMIT_PER_MINUTE=30
# OREOCHAIN_VERIFY_RATE_LIMIT_BURST=10

# ------------------------------------------------------- the anchoring worker
#
# A second process (server/anchor-worker.mjs), which submits batch roots
# on-chain. It holds a key that can spend, which is why it is not the gateway.
# None of the four required settings has a default: without them the worker
# refuses to start rather than quietly anchoring nothing.

# OREOCHAIN_CHAIN_RPC=https://rpc.example
# OREOCHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# The funded key that signs anchor transactions. Its address must be an
# authorised exporter on the contract. Prefer the _FILE twin: this one is worth
# money.
# OREOCHAIN_ANCHOR_KEY=
# OREOCHAIN_ANCHOR_KEY_FILE=/run/secrets/anchor_key

# How the worker authenticates to the gateway. It must appear in the gateway's
# OREOCHAIN_ANCHOR_API_KEYS (and therefore in OREOCHAIN_API_KEYS), and should be
# issued to the worker alone so it can be revoked without touching any client.
# This is not the chain key above: that one pays for transactions, this one
# opens a door on the gateway.
# OREOCHAIN_ANCHOR_API_KEY=
# OREOCHAIN_ANCHOR_API_KEY_FILE=/run/secrets/anchor_api_key

# OREOCHAIN_GATEWAY_URL=http://gateway:8787

# How often to look for work, and how deep an anchor must be before a receipt
# is allowed to point at it. One confirmation means a reorg can leave a whole
# batch of receipts pointing at a transaction that no longer exists.
# OREOCHAIN_ANCHOR_INTERVAL_MS=60000
# OREOCHAIN_ANCHOR_CONFIRMATIONS=3

# Written into the anchor as where this batch's proofs are served. {root} is
# substituted. Empty means the anchor carries no pointer for a verifier.
# OREOCHAIN_ANCHOR_URI=https://proofs.example.com/batch/{root}

# ------------------------------------------------------------ local testing

# Keeps everything in memory and needs no Pinata account. Never in production.
# OREOCHAIN_STORAGE=memory
